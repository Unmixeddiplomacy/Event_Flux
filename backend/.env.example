# Database connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# Server configuration
PORT=8000
HOST="0.0.0.0"
API_URL="http://localhost:8000"

# Arcjet security (rate limiting & bot detection)
ARCJET_KEY="your_arcjet_api_key_here"
ARCJET_ENV="development"

# Ingestion configuration
# INGESTION_MODE: "live" (poll sports API) or "seed" (use deterministic seed data)
INGESTION_MODE="live"
# Football Ingestion configuration
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"
POLL_INTERVAL_MS="15000"


# Seed Replayer configuration
BROADCAST="1"
DELAY_MS="250"
MATCH_COUNT="0"
